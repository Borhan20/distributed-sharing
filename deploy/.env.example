# Copy to deploy/.env and change every value. Never commit deploy/.env.
POSTGRES_PASSWORD=change-me
# Comma-free JSON list of user handles that are server admins, e.g. ["alice"]
POOL_SERVER_ADMINS=[]
# Interface to publish ports on. Keep 127.0.0.1 unless a TLS reverse proxy is in front.
POOL_BIND=127.0.0.1
# OIDC mode only (compose.oidc.yaml)
KEYCLOAK_ADMIN_PASSWORD=change-me
# Object store (profile "storage"); must match deploy/seaweedfs-s3.json
POOL_S3_ENDPOINT=
POOL_S3_ACCESS_KEY=
POOL_S3_SECRET_KEY=
