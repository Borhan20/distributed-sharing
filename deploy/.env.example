# Copy to deploy/.env and change every value. Never commit deploy/.env.
POSTGRES_PASSWORD=change-me
# Comma-free JSON list of user handles that are server admins, e.g. ["alice"]
POOL_SERVER_ADMINS=[]
# Interface to publish ports on. Keep 127.0.0.1 unless a TLS reverse proxy is in front.
POOL_BIND=127.0.0.1
# OIDC mode only (compose.oidc.yaml)
KEYCLOAK_ADMIN_PASSWORD=change-me
# Object store for job outputs (optional; profile "storage"). Leave all empty to keep
# outputs on the devices that produced them. Otherwise set all of:
#   POOL_S3_ENDPOINT         address the server uses: http://seaweedfs:8333 with the bundled store
#   POOL_S3_PUBLIC_ENDPOINT  address agents upload to, written into the upload links. Must be https on a
#                            shared server (agents refuse plain http), e.g. https://s3.example.org through
#                            a TLS reverse proxy that keeps the Host header. Defaults to POOL_S3_ENDPOINT.
#   POOL_S3_ACCESS_KEY / POOL_S3_SECRET_KEY  random strings you choose (openssl rand -hex 16 / 32); put the
#                            same pair in deploy/seaweedfs-s3.json (copy the .example).
# The server creates the bucket (pool-artifacts) at startup; /readyz shows "object_store": "ready".
POOL_S3_ENDPOINT=
POOL_S3_PUBLIC_ENDPOINT=
POOL_S3_ACCESS_KEY=
POOL_S3_SECRET_KEY=
